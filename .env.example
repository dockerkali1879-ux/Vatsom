# ============================================================================
# VATSOM — Environment Variables Template (.env.example)
# NEVER commit real secrets to version control.
# ============================================================================
DATABASE_URL="postgresql://vatsom_app_runtime:REPLACE_WITH_RUNTIME_PASSWORD@ep-example-pooler.ap-south-1.aws.neon.tech/vatsom_dev?sslmode=require"
DIRECT_DATABASE_URL="postgresql://vatsom_migrator:REPLACE_WITH_MIGRATOR_PASSWORD@ep-example.ap-south-1.aws.neon.tech/vatsom_dev?sslmode=require"
GOOGLE_CLIENT_ID="REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="REPLACE_WITH_TURNSTILE_SECRET_KEY"
SESSION_SIGNING_SECRET="REPLACE_WITH_64_HEX_CHARACTER_RANDOM_SECRET"
ADMIN_ALLOWLIST="admin@vatsom.in"
CF_ACCESS_TEAM_DOMAIN="REPLACE_WITH_YOUR_TEAM.cloudflareaccess.com"
CF_ACCESS_AUD="REPLACE_WITH_CLOUDFLARE_ACCESS_APPLICATION_AUD_TAG"
EMAIL_PROVIDER="none"
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="atelier@vatsom.in"
COURIER_WEBHOOK_SECRET="REPLACE_WITH_COURIER_WEBHOOK_HMAC_SECRET"

